  "bays": "<section class=\"g\" id=\"app-studio\"><div class=\"wrap\"><div class=\"studio hero-st\" id=\"studio\"><div class=\"st-left\"><div><p class=\"eyebrow\">UI/UX &amp; web design</p>\n<h2 style=\"margin-top:14px\">Beautiful apps for <em>every</em> platform.</h2>\n<p class=\"lede\" style=\"margin-top:20px\">We design and develop mobile apps, websites and desktop software that people enjoy using. Pick a style, switch the platform, or ask our robot to use the app for you.</p>\n<div class=\"ctas\" style=\"margin-top:26px\"><a class=\"btn primary\" href=\"/contact/\">Start your app project</a><a class=\"btn\" href=\"/ui-ux-design/\">UI/UX design →</a></div></div><div class=\"st-pick\"><div class=\"st-lbl\">Design style <span id=\"stName\"></span></div><div class=\"chips st-themes\" role=\"group\" aria-label=\"Design style\"><button class=\"chip st-chip\" type=\"button\" data-theme-pick=\"aurum\" aria-pressed=\"true\"><i style=\"background:#C9A45C\"></i>Luxury hotel</button><button class=\"chip st-chip\" type=\"button\" data-theme-pick=\"vita\" aria-pressed=\"false\"><i style=\"background:#0E9F8E\"></i>Healthcare</button><button class=\"chip st-chip\" type=\"button\" data-theme-pick=\"nova\" aria-pressed=\"false\"><i style=\"background:#6D4CFF\"></i>Fintech</button><button class=\"chip st-chip\" type=\"button\" data-theme-pick=\"bloom\" aria-pressed=\"false\"><i style=\"background:#FF6B35\"></i>Food delivery</button><button class=\"chip st-chip\" type=\"button\" data-theme-pick=\"maison\" aria-pressed=\"false\"><i style=\"background:#1A1A1A\"></i>Fashion store</button><button class=\"chip st-chip\" type=\"button\" data-theme-pick=\"atlas\" aria-pressed=\"false\"><i style=\"background:#2F5BEA\"></i>Enterprise ERP</button></div><div class=\"st-row\"><div class=\"seg\" role=\"group\" aria-label=\"Platform\"><button type=\"button\" data-plat-pick=\"ios\" aria-pressed=\"true\">iOS</button><button type=\"button\" data-plat-pick=\"android\" aria-pressed=\"false\">Android<